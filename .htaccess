# ============================================================
#  PRODUCTION .htaccess — Manoj S Portfolio
#  Apache 2.4+ | mod_rewrite, mod_headers, mod_deflate,
#  mod_expires, mod_setenvif required (standard on most hosts)
# ============================================================

# ------------------------------------------------------------
# 1. DISABLE DIRECTORY LISTING
# ------------------------------------------------------------
Options -Indexes
Options -MultiViews

# ------------------------------------------------------------
# 2. PROTECT HIDDEN / VERSION-CONTROL FILES
# ------------------------------------------------------------
<FilesMatch "^\.(htaccess|htpasswd|env|git|gitignore|gitattributes)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Block any dotfile (.env, .git, .htaccess, etc.)
  RewriteCond %{SCRIPT_FILENAME} -f
  RewriteRule "(^|/)\." - [F]
</IfModule>

<DirectoryMatch "^.*/\.git/.*$">
  Require all denied
</DirectoryMatch>

# ------------------------------------------------------------
# 3. BLOCK ACCESS TO SENSITIVE / CONFIG FILE TYPES
# ------------------------------------------------------------
<FilesMatch "\.(env|ini|log|sql|bak|config|json|yml|yaml)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(composer\.json|composer\.lock|package\.json|package-lock\.json)$">
  Require all denied
</FilesMatch>

# ------------------------------------------------------------
# 4. GZIP COMPRESSION
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/font-woff
  AddOutputFilterByType DEFLATE application/font-woff2
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2

  # Don't compress already-compressed formats
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|zip|gz|bz2|rar|mp4|webm)$ no-gzip

  <IfModule mod_setenvif.c>
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  </IfModule>
</IfModule>

# Brotli (used automatically instead of gzip when the host/CDN supports it)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------
# 5. BROWSER CACHING
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images → 1 year
  ExpiresByType image/jpg               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"

  # Fonts → 1 year
  ExpiresByType font/woff               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType application/font-woff   "access plus 1 year"
  ExpiresByType application/font-woff2  "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
  ExpiresByType font/ttf                "access plus 1 year"
  ExpiresByType font/otf                "access plus 1 year"

  # CSS → 1 month
  ExpiresByType text/css                "access plus 1 month"

  # JavaScript → 1 month
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType text/javascript         "access plus 1 month"

  # HTML → do not cache aggressively (content changes)
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|gif|svg|ico|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------
# 6. SECURITY HEADERS
# ------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set X-XSS-Protection "1; mode=block"

  # HSTS — only takes effect over HTTPS, safe to always send
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Content-Security-Policy — allow only required self + known CDN resources.
  # NOTE: 'unsafe-inline'/'unsafe-eval' are required because the site currently
  # uses the Tailwind CDN JIT compiler and inline <script>/<style> blocks.
  # See SECURITY.md for a stricter CSP once the build step (Section: Frontend
  # Optimization) extracts CSS/JS into hashed external files.
  Header always set Content-Security-Policy "default-src 'self'; \
    script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://code.iconify.design https://cdnjs.cloudflare.com; \
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
    font-src 'self' https://fonts.gstatic.com; \
    img-src 'self' data:; \
    connect-src 'self' https://api.iconify.design https://code.iconify.design; \
    frame-ancestors 'self'; \
    base-uri 'self'; \
    form-action 'self'; \
    object-src 'none'"

  # Remove identifying headers where possible (also set ServerTokens below)
  Header unset X-Powered-By
</IfModule>

# ------------------------------------------------------------
# 7. DISABLE ETAGS (avoid leaking inode/filesystem info)
# ------------------------------------------------------------
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>

# ------------------------------------------------------------
# 8. HIDE APACHE VERSION / SERVER SIGNATURE
#    (ServerTokens/ServerSignature must be set in httpd.conf on
#    shared hosting where .htaccess can't override them — kept
#    here for VPS/dedicated servers where AllowOverride All applies)
# ------------------------------------------------------------
ServerSignature Off
<IfModule mod_headers.c>
  Header unset Server
</IfModule>

# ------------------------------------------------------------
# 9. PREVENT MIME SNIFFING (also covered by header above)
# ------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# ------------------------------------------------------------
# 10. PROTECT SENSITIVE FOLDERS
# ------------------------------------------------------------
RewriteEngine On
RewriteRule ^assets/private/ - [F,L,NC]
RewriteRule ^config/ - [F,L,NC]
RewriteRule ^uploads/private/ - [F,L,NC]
RewriteRule ^storage/ - [F,L,NC]

<IfModule !mod_rewrite.c>
  <LocationMatch "^/(assets/private|config|uploads/private|storage)/">
    Require all denied
  </LocationMatch>
</IfModule>

# ------------------------------------------------------------
# FORCE HTTPS (uncomment once SSL is confirmed live on the host)
# ------------------------------------------------------------
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ------------------------------------------------------------
# DEFAULT CHARSET
# ------------------------------------------------------------
AddDefaultCharset UTF-8

# ------------------------------------------------------------
# DISABLE SERVER-SIDE INCLUDES / CGI EXECUTION IN UPLOAD DIRS
# ------------------------------------------------------------
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
